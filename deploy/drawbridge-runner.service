# drawbridge-runner systemd unit (install to /etc/systemd/system/).
# The Runner is the only principal with Docker socket and repository access.
# Keep it out of the `docker` group only if the socket path differs; the
# unit below assumes access to /var/run/docker.sock via group membership of
# the drawbridge-runner user (verify with `systemd-analyze security`).
[Unit]
Description=Drawbridge Runner (deployment principal)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drawbridge-runner
Group=drawbridge
ExecStart=/opt/drawbridge/venv/bin/drawbridge-runner --config-dir /etc/drawbridge
Restart=on-failure
RestartSec=3
# A crashed Runner must be inspected before any retry touches containers:
# on repeated failure, stop and page the operator instead of looping.
StartLimitIntervalSec=300
StartLimitBurst=5

# ---- hardening (shared baseline) ----
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# state.db/WAL/SHM must stay group-writable: Gateway and Runner are two
# accounts sharing the `drawbridge` group and one SQLite database.
UMask=0007

# Runner-specific: state, deploy roots, registered repos, build + logs;
# AF_UNIX for the Docker/BuildKit sockets, INET for git fetch egress.
ReadWritePaths=/var/lib/drawbridge /srv/drawbridge /var/log/drawbridge /run/drawbridge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Docker Engine socket access is group-based: the drawbridge-runner account
# must be a member of `docker` (see docs/DEPLOYMENT.md §2).  Verify with
# `sudo -u drawbridge-runner docker version` before first dispatch.
SupplementaryGroups=docker
# NPU read-only observation (npu_status) under systemd: PrivateDevices=false
# plus an explicit DeviceAllow list is REQUIRED — without it the device nodes
# are invisible even when npu.enabled is true (nohup deploys do not have this
# restriction).  Enable together with the apps.yaml npu section and list only
# the registered devices, e.g. for /dev/davinci2:
#   DeviceAllow=/dev/davinci_manager rw
#   DeviceAllow=/dev/davinci2 rw
PrivateDevices=false
DeviceAllow=char-uart rw

[Install]
WantedBy=multi-user.target
